{
  "name": "zyvoriq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "guard:scope": "node scripts/guards/guard_codebase_scope.mjs",
    "guard:mocks": "node scripts/guards/guard_no_synthetic_mocks.mjs",
    "guard:trinity": "node scripts/guards/enforce_universal_single_source_trinity.mjs",
    "guard:sync": "node scripts/guards/enforce_universal_single_source_trinity.mjs --auto-heal",
    "guard:drift": "node scripts/guards/enforce_universal_single_source_trinity.mjs --verify-only",
    "guard:deterministic": "npm run guard:scope && npm run guard:mocks && npm run guard:legacy && npm run canonical:qa && npm run dual-db:qa",
    "guard:legacy": "node scripts/governance/legacy_tech_guard.js",
    "docs:validate": "node scripts/governance/validate_docs_traceability.mjs",
    "narration:qa": "node scripts/qa/transcription_word_timing_guard_test.mjs",
    "canonical:qa": "node scripts/qa/verify_veo_engine_routing_and_provenance.mjs && node scripts/qa/reel_sqlite_dual_engine_test.mjs",
    "dual-db:qa": "node scripts/qa/reel_sqlite_dual_engine_test.mjs",
    "library:qa": "node scripts/qa/library_direct_media_actions_test.mjs",
    "artifact:qa": "node scripts/qa/artifact_identity_contract_test.mjs",
    "manifest-read:qa": "node scripts/qa/reel_manifest_read_compatibility_test.mjs",
    "check": "npm run canonical:qa && next build",
    "build": "npm run canonical:qa && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-8080}",
    "deploy": "npm run build && python3 scripts/deploy_zyvoriq_cloudrun.py",
    "test:e2e": "node scripts/cloudtop_puppeteer_remote.js",
    "test:sprints": "node scripts/e2e/test_all_sprints.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@material/web": "^2.5.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-materials-mtoon": "^3.5.5",
    "@types/three": "^0.185.4",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "next": "15.4.10",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "gifenc": "^1.0.3",
    "postcss": "^8.4.49",
    "puppeteer": "^24.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
